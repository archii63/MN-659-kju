## veyra.py

#!/usr/bin/env python3

import argparse
import json
import sys
import time
import urllib.error
import urllib.request
from concurrent.futures import ThreadPoolExecutor, as_completed
from datetime import datetime, timezone


USER_AGENT = "Veyra/1.0"


def load_config(path):
    with open(path, "r", encoding="utf-8") as file:
        return json.load(file)


def check_endpoint(endpoint, timeout, retries):
    name = endpoint["name"]
    url = endpoint["url"]
    expected_status = endpoint.get("expected_status", 200)

    last_error = None

    for attempt in range(retries + 1):
        start = time.perf_counter()

        try:
            request = urllib.request.Request(
                url,
                headers={
                    "User-Agent": USER_AGENT,
                    "Accept": "*/*"
                },
                method="GET"
            )

            with urllib.request.urlopen(
                request,
                timeout=timeout
            ) as response:

                status = response.status
                response.read(1)

            elapsed = round(
                (time.perf_counter() - start) * 1000,
                2
            )

            return {
                "name": name,
                "url": url,
                "status": status,
                "response_time_ms": elapsed,
                "healthy": status == expected_status,
                "error": None
            }

        except urllib.error.HTTPError as error:
            elapsed = round(
                (time.perf_counter() - start) * 1000,
                2
            )

            return {
                "name": name,
                "url": url,
                "status": error.code,
                "response_time_ms": elapsed,
                "healthy": error.code == expected_status,
                "error": str(error)
            }

        except Exception as error:
            last_error = str(error)

            if attempt < retries:
                time.sleep(0.5)

    return {
        "name": name,
        "url": url,
        "status": None,
        "response_time_ms": None,
        "healthy": False,
        "error": last_error
    }


def run_monitor(config):
    timeout = config.get("timeout", 10)
    retries = config.get("retries", 2)
    endpoints = config.get("endpoints", [])

    if not endpoints:
        raise ValueError("No endpoints configured.")

    results = []

    workers = min(len(endpoints), 10)

    with ThreadPoolExecutor(max_workers=workers) as executor:
        futures = [
            executor.submit(
                check_endpoint,
                endpoint,
                timeout,
                retries
            )
            for endpoint in endpoints
        ]

        for future in as_completed(futures):
            results.append(future.result())

    results.sort(key=lambda item: item["name"])

    healthy = sum(
        1 for result in results
        if result["healthy"]
    )

    return {
        "timestamp": datetime.now(timezone.utc).isoformat(),
        "total": len(results),
        "healthy": healthy,
        "failed": len(results) - healthy,
        "endpoints": results
    }


def save_report(report, output):
    with open(output, "w", encoding="utf-8") as file:
        json.dump(
            report,
            file,
            indent=2,
            ensure_ascii=False
        )


def print_summary(report):
    print()
    print("Veyra Endpoint Monitor")
    print("-" * 40)

    for endpoint in report["endpoints"]:
        status = (
            "OK"
            if endpoint["healthy"]
            else "FAILED"
        )

        response_time = endpoint["response_time_ms"]

        if response_time is not None:
            latency = f"{response_time} ms"
        else:
            latency = "N/A"

        print(
            f"[{status}] "
            f"{endpoint['name']} "
            f"| {latency}"
        )

        if endpoint["error"]:
            print(
                f"      Error: {endpoint['error']}"
            )

    print("-" * 40)
    print(
        f"Total: {report['total']} | "
        f"Healthy: {report['healthy']} | "
        f"Failed: {report['failed']}"
    )
    print()


def main():
    parser = argparse.ArgumentParser(
        description="Veyra HTTP endpoint monitoring tool."
    )

    parser.add_argument(
        "--config",
        default="config.json",
        help="Path to the configuration file."
    )

    parser.add_argument(
        "--output",
        default="veyra-report.json",
        help="Path for the JSON report."
    )

    args = parser.parse_args()

    try:
        config = load_config(args.config)
        report = run_monitor(config)

        save_report(
            report,
            args.output
        )

        print_summary(report)

        # Exit with code 1 when at least one
        # endpoint is unhealthy.
        if report["failed"] > 0:
            sys.exit(1)

    except FileNotFoundError:
        print(
            f"Configuration file not found: {args.config}",
            file=sys.stderr
        )
        sys.exit(2)

    except json.JSONDecodeError as error:
        print(
            f"Invalid JSON configuration: {error}",
            file=sys.stderr
        )
        sys.exit(2)

    except Exception as error:
        print(
            f"Veyra error: {error}",
            file=sys.stderr
        )
        sys.exit(2)


if __name__ == "__main__":
    main()


